NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

OPENAI_API_KEY=

NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Official Google Maps Platform (optional). Enables Google map tiles,
# Directions, and lodging search. Without a key the app uses OpenStreetMap,
# OSRM road routes, and OSM/hotel fallbacks.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_API_KEY=
