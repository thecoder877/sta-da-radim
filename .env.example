NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only secret used to sign the anonymous generation-quota cookie.
# Optional: without it the cookie counter still works but is not tamper-proof.
APP_SECRET=

OPENAI_API_KEY=

# Official Google Maps Platform (optional). NEXT_PUBLIC_ key enables the
# in-browser Google map; the server-only key enables Directions and lodging
# search. Without a key the app uses OpenStreetMap, OSRM road routes, and
# OSM/hotel fallbacks.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_API_KEY=
